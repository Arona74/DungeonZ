{
  "schemaVersion": 1,
  "id": "dungeonz",
  "version": "${version}",
  "name": "DungeonZ - Bleak Isles Edition",
  "description": "This mod adds the basement for creating and exploring dungeons, edited by Arona74 for Conquest of the Bleak Isles Modpack",
  "authors": [
    "Globox_Z",
    "Zura",
    "xeven",
    "LeDok",
    "Arona74"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/dungeonz",
    "sources": "https://github.com/Arona74/Dungeonz",
    "issues": "https://github.com/Arona74/Dungeonz/issues"
  },
  "license": "MIT",
  "icon": "assets/dungeonz/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dungeonz.DungeonzMain"
    ],
    "client": [
      "net.dungeonz.DungeonzClient"
    ],
    "modmenu": [
      "net.dungeonz.config.ModMenuIntegration"
    ],
    "emi": [
      "net.dungeonz.compat.DungeonEmiPlugin"
    ],
    "rei_client": [
      "net.dungeonz.compat.DungeonReiPlugin"
    ]
  },
  "accessWidener": "dungeonz.accesswidener",
  "mixins": [
    "dungeonz.mixins.json"
  ],
  "depends": {
    "java": ">=17",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}"
  },
  "suggests": {
    "factions": "*",
    "lootr": "*"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "11jwniuC",
      "curseforge": 864150
    }
  }
}